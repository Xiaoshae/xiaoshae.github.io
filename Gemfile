source 'https://gems.ruby-china.com'

# Keep rendering and the RSS generator marker byte-for-byte compatible.
gem "jekyll", "4.3.3"
gem "jekyll-paginate", "1.1.0"

# Jekyll 4.3 expects these libraries from Ruby's older standard library.
# Declare them explicitly for Ruby 4 rather than relying on implicit gems.
gem "base64"
gem "csv"
gem "json"
gem "logger"
